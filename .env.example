# PROP EDGE AI — copy to .env and set secrets for local/Docker use
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
LOG_LEVEL=INFO

# Default admin (created on first migration seed if no users exist)
INITIAL_ADMIN_EMAIL=admin@propedge.local
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Market data — no keys = providers show "not_configured"
DATABENTO_API_KEY=
IBKR_HOST=
IBKR_PORT=

# AI research — empty = researcher jobs report configuration required
OPENAI_API_KEY=
AI_RESEARCH_ENABLED=false
MAX_EXPERIMENTS_PER_DAY=50

DATABASE_URL=postgresql+asyncpg://propedge:propedge_dev@localhost:5432/propedge
DATABASE_URL_SYNC=postgresql://propedge:propedge_dev@localhost:5432/propedge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2