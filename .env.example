# PROP EDGE AI — copy to .env and set secrets for local/Docker use
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
LOG_LEVEL=INFO

# Default admin (created on first migration seed if no users exist)
INITIAL_ADMIN_EMAIL=admin@propedge.local
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Market data — no keys = providers show "not_configured"
DATABENTO_API_KEY=
IBKR_HOST=
IBKR_PORT=

# AI research — empty = researcher jobs report configuration required
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RESEARCH_ENABLED=false
MAX_EXPERIMENTS_PER_DAY=50
AUTONOMOUS_HOURLY_ENABLED=true
# Autopilot markets — MNQ & NQ are always searched even if omitted
SEARCH_SYMBOLS=MNQ,NQ,MES,ES
SEARCH_BUDGET_PER_SYMBOL=150
SEARCH_HISTORY_DAYS=50
REVERSE_SEARCH_ENABLED=true
# Original WR at or below this is treated as anti-edge (8% → 92% implied reverse WR)
REVERSE_WINRATE_MAX=0.20
# Simulated prop evaluation used by the forward-test book
PAPER_STARTING_EQUITY=100000
PAPER_DAILY_LOSS=2000
PAPER_TRAILING_DD=3000
PAPER_PROFIT_TARGET=6000
PAPER_MAX_SLOTS=4

DATABASE_URL=postgresql+asyncpg://propedge:propedge_dev@localhost:5432/propedge
DATABASE_URL_SYNC=postgresql://propedge:propedge_dev@localhost:5432/propedge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Railway / production
# DATABASE_URL and REDIS_URL are injected by Railway (postgres:// → auto-converted for async SQLAlchemy)
# PORT=8000                                    # set by Railway on API service
# ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# PROP_EDGE_ROLE=api|worker|beat               # per Railway service (see docs/DEPLOY_RAILWAY.md)