# PROP EDGE AI — copy to .env and set secrets for local/Docker use
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
LOG_LEVEL=INFO

# Default admin (created on first migration seed if no users exist)
INITIAL_ADMIN_EMAIL=admin@propedge.local
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Market data — no keys = providers show "not_configured"
# FinzData (historical futures): free key is daily bars only; 1m/5m needs a paid market
FINZDATA_API_KEY=
# When set, deep prop search prefers Databento GLBX (1m→5m) over Yahoo
DATABENTO_API_KEY=
# Historical Data Engine 3.0 — paid download budget & GBP display (optional FX for estimates)
RESEARCH_DATA_BUDGET_GBP=50
GBP_USD_RATE=
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=11
SEARCH_PREFER_IBKR=false
SEARCH_TIMEFRAMES=5m,1m
SEARCH_1M_BUDGET_PER_SYMBOL=72
SEARCH_1M_HISTORY_DAYS=7
# Daily parquet files for OHLCV (not Postgres rows). Mount a Railway volume at /data in prod.
OHLCV_STORE_DIR=data/ohlcv
# Railway: mount volume at /data/ohlcv and set OHLCV_STORE_DIR=/data/ohlcv
OHLCV_PERSISTENT_REQUIRED=false
OHLCV_S3_BUCKET=
# Live Databento cost smoke only (no download): DATABENTO_LIVE_SMOKE=true
DATABENTO_LIVE_SMOKE=false

# AI research — empty = researcher jobs report configuration required
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RESEARCH_ENABLED=false
MAX_EXPERIMENTS_PER_DAY=50
AUTONOMOUS_HOURLY_ENABLED=true
# Autopilot markets — MNQ & NQ are always searched even if omitted
SEARCH_SYMBOLS=MNQ,NQ,MES,ES
SEARCH_BUDGET_PER_SYMBOL=150
# Plain integer only (not 60+)
SEARCH_HISTORY_DAYS=50
SEARCH_STALE_QUEUED_MINUTES=12
SEARCH_STALE_RUNNING_MINUTES=25
SEARCH_BACKTEST_TIMEOUT_S=90
SEARCH_WALKFORWARD_FOLDS=3
SEARCH_OOS_MIN_WIN_RATE=0.38
SEARCH_AI_ROUNDS=2
SEARCH_AI_SPECS_PER_ROUND=14
REVERSE_SEARCH_ENABLED=true
SEARCH_ROBUSTNESS_ENABLED=true
SEARCH_ROBUSTNESS_SHUFFLES=8
SEARCH_STRESS_SLIP_TICKS=2
SEARCH_ROBUSTNESS_MIN_PASS=0.5
# Original WR at or below this is treated as anti-edge (8% → 92% implied reverse WR)
REVERSE_WINRATE_MAX=0.20
# Simulated prop evaluation used by the forward-test book
PAPER_STARTING_EQUITY=100000
PAPER_DAILY_LOSS=2000
PAPER_TRAILING_DD=3000
PAPER_PROFIT_TARGET=6000
PAPER_MAX_SLOTS=8

DATABASE_URL=postgresql+asyncpg://propedge:propedge_dev@localhost:5432/propedge
DATABASE_URL_SYNC=postgresql://propedge:propedge_dev@localhost:5432/propedge
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Railway / production
# DATABASE_URL and REDIS_URL are injected by Railway (postgres:// → auto-converted for async SQLAlchemy)
# PORT=8000                                    # set by Railway on API service
# ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# PROP_EDGE_ROLE=api|worker|beat               # per Railway service (see docs/DEPLOY_RAILWAY.md)